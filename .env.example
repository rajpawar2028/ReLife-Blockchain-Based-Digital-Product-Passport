# =================================================================
# ReLife - Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env  (or copy manually in Windows Explorer)
# NEVER commit your actual .env file or real private keys to git!
# =================================================================

# --- Network Configuration (Sepolia Testnet) ---
# Dedicated Alchemy or Infura Sepolia RPC URL (e.g. https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY)
# Get a free API key at https://www.alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key_here

# Deployer Testnet Private Key (from MetaMask / test wallet - MUST ONLY CONTAIN TEST ETH)
# DO NOT include the "0x" prefix (must be exactly 64 hexadecimal characters)
# (Supported by hardhat.config.js via PRIVATE_KEY or SEPOLIA_PRIVATE_KEY)
PRIVATE_KEY=your_private_key_without_0x_prefix
SEPOLIA_PRIVATE_KEY=your_private_key_without_0x_prefix

# --- Blockchain Explorer Verification ---
# Etherscan API key to verify contracts on Sepolia (get free at https://etherscan.io)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- IPFS & Decentralized Storage (Pinata) ---
# Used strictly by the Express backend proxy to upload passport metadata & files to IPFS
# Get free API credentials at https://www.pinata.cloud
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Backend Server Configuration ---
PORT=5000
